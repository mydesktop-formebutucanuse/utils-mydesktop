#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Brightness keys.
#
#   backlight screen +N|-N   one step brighter or dimmer. autobrightd does
#                            the change: 16 steps from 2 nits to the
#                            maximum, even as the eye sees them, each one a
#                            short glide. N only gives the direction.
#   backlight kbd +N|-N      keyboard backlight by N % of its maximum,
#                            through elogind's Session.SetBrightness.
set -eu

usage() {
	echo "usage: ${0##*/} screen|kbd +N|-N" >&2
	exit 2
}

pct=${2:-}
case "$pct" in
[+-][0-9]*) ;;
*) usage ;;
esac

case "${1:-}" in
screen)
	# autobrightd takes SIGUSR1 as brighter and SIGUSR2 as dimmer.
	case "$pct" in
	-*) sig=USR2 ;;
	*) sig=USR1 ;;
	esac
	if ! pkill "-$sig" -x -u "$(id -u)" autobrightd; then
		echo "${0##*/}: autobrightd is not running" >&2
		exit 1
	fi
	;;
kbd)
	dir=/sys/class/leds/kbd_backlight
	if [ ! -r "$dir/brightness" ]; then
		echo "${0##*/}: no keyboard backlight" >&2
		exit 1
	fi
	cur=$(cat "$dir/brightness")
	max=$(cat "$dir/max_brightness")
	step=$((max * ${pct#?} / 100))
	[ "$step" -ge 1 ] || step=1
	case "$pct" in
	-*) new=$((cur - step)) ;;
	*) new=$((cur + step)) ;;
	esac
	[ "$new" -ge 0 ] || new=0
	[ "$new" -le "$max" ] || new=$max
	exec dbus-send --system --print-reply=literal \
		--dest=org.freedesktop.login1 /org/freedesktop/login1/session/auto \
		org.freedesktop.login1.Session.SetBrightness \
		string:leds string:kbd_backlight uint32:"$new" >/dev/null
	;;
*)
	usage
	;;
esac
