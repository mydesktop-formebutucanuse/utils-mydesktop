# mediakeyd config (~/.config/mediakeyd/config)
#
#   KEYSYM  repeat|once  COMMAND
#
# COMMAND runs with /bin/sh -c. Keys are not grabbed, so the focused
# application still receives them. "repeat" keys repeat at the X server's
# rate (xset r rate) while they are held down. A key's command never runs
# twice at the same time; presses during a run are merged into one more run.

# Volume (PipeWire). Raising the volume also unmutes, capped at 100%.
XF86AudioRaiseVolume   repeat  wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
XF86AudioLowerVolume   repeat  wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
XF86AudioMute          once    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Screen brightness and keyboard backlight (elogind, no root).
# backlight is backlight/backlight of utils-mydesktop, installed to ~/.local/bin.
XF86MonBrightnessUp    repeat  $HOME/.local/bin/backlight screen +5
XF86MonBrightnessDown  repeat  $HOME/.local/bin/backlight screen -5
XF86KbdBrightnessUp    repeat  $HOME/.local/bin/backlight kbd +10
XF86KbdBrightnessDown  repeat  $HOME/.local/bin/backlight kbd -10

# Media players (MPRIS)
XF86AudioPlay          once    playerctl play-pause
XF86AudioNext          once    playerctl next
XF86AudioPrev          once    playerctl previous
