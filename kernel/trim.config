# wmutils: installed as /etc/kernel/config.d/wmutils-trim.config
# by kernel/install.sh. sys-kernel/asahi-kernel merges it last, on top of the
# Fedora-based dist-kernel config, and so builds less than half the modules.
#
# What goes: drivers for hardware that cannot be connected to a 14-inch
# MacBook Pro (M1 Pro), kernel self-tests, and cluster and server parts that
# nothing installed uses. What stays: every driver this Mac uses, everything
# that can come in over USB-C or Bluetooth except TV and radio tuners and
# analog video grabbers (USB Ethernet, Wi-Fi, storage, serial, audio,
# webcams, displays, HID devices, game controllers, CAN, NFC), and generic
# software other than those server parts: file systems, network protocols,
# netfilter, KVM, vhost, virtio, md and dm, the iSCSI initiator. It only
# turns options off.
#
# Made for asahi-kernel 7.2.14_p1 and refreshed for 7.3.3_p2. A later
# kernel builds its new drivers until this list is refreshed, and ignores
# names it no longer has. See kernel/README.md for how the list was made,
# checked and refreshed, and for turning something back on.

## Whole menus: hardware this MacBook cannot take
# Ethernet cards (PCI) and SoC Ethernet. USB Ethernet adapters are a separate menu and stay.
# CONFIG_ETHERNET is not set
# InfiniBand and RDMA cards, and RDMA over plain Ethernet (rxe, siw), which nothing
# installed uses.
# CONFIG_INFINIBAND is not set
# Ethernet switch chips on boards (DSA).
# CONFIG_NET_DSA is not set
# SATA and PATA controllers. USB disks go through usb-storage and uas.
# CONFIG_ATA is not set
# PCI sound cards and PCI HD Audio.
# CONFIG_SND_PCI is not set
# CONFIG_SND_HDA_INTEL is not set
# Sound Open Firmware DSPs (Intel, AMD, NXP, MediaTek), SoundWire, SLIMbus.
# CONFIG_SND_SOC_SOF_TOPLEVEL is not set
# CONFIG_SOUNDWIRE is not set
# CONFIG_SLIMBUS is not set
# TV and radio tuners and analog video capture, USB ones included (nothing for TV is
# installed), PCI capture cards, camera sensors for SoC camera interfaces, and the
# media test drivers. Webcams (uvcvideo, gspca) stay.
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_PCI_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
# CONFIG_VIDEO_CAMERA_SENSOR is not set
# Staging: an SDIO Wi-Fi chip and a car camera deserializer.
# CONFIG_STAGING is not set
# Platform drivers for Chromebooks, Surface, Mellanox switches and BlueField, and
# Snapdragon laptops.
# CONFIG_CHROME_PLATFORMS is not set
# CONFIG_SURFACE_PLATFORMS is not set
# CONFIG_MELLANOX_PLATFORM is not set
# CONFIG_ARM64_PLATFORM_DEVICES is not set
# FPGAs, CoreSight and STM tracing, RapidIO, game ports on PCI sound cards,
# the VMware guest network card.
# CONFIG_FPGA is not set
# CONFIG_CORESIGHT is not set
# CONFIG_STM is not set
# CONFIG_RAPIDIO is not set
# CONFIG_GAMEPORT is not set
# CONFIG_VMXNET3 is not set
# Raw NAND flash chips. The SPI NOR flash this Mac boots from stays.
# CONFIG_MTD_RAW_NAND is not set

## Kernel self-tests
# KUnit and every test module that comes with it, the runtime test modules,
# torture tests, and test-only devices.
# CONFIG_KUNIT is not set
# CONFIG_RUNTIME_TESTING_MENU is not set
# CONFIG_RCU_TORTURE_TEST is not set
# CONFIG_LOCK_TORTURE_TEST is not set
# CONFIG_NETDEVSIM is not set
# CONFIG_BLK_DEV_NULL_BLK is not set
# CONFIG_BLK_DEV_RUST_NULL is not set
# CONFIG_I2C_STUB is not set
# CONFIG_SCSI_DEBUG is not set

## Cluster and server parts with nothing installed to use them
# The SCSI target (LIO, which vhost-scsi and the USB mass storage gadget also
# need; targetcli is not installed), GFS2, the DLM, Ceph (file system and block
# device), the NFS server, DRBD. The NFS and SMB clients stay.
# CONFIG_TARGET_CORE is not set
# CONFIG_GFS2_FS is not set
# CONFIG_DLM is not set
# CONFIG_CEPH_FS is not set
# CONFIG_BLK_DEV_RBD is not set
# CONFIG_CEPH_LIB is not set
# CONFIG_NFSD is not set
# CONFIG_BLK_DEV_DRBD is not set

