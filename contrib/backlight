#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Change the screen or keyboard backlight through elogind's
# Session.SetBrightness, so no root or udev rule is needed.
#
# usage: backlight screen|kbd +N|-N     (N = percent of the maximum)
set -eu

usage() {
	echo "usage: ${0##*/} screen|kbd +N|-N" >&2
	exit 2
}

case "${1:-}" in
screen)
	subsys=backlight
	dir=$(ls -d /sys/class/backlight/* 2>/dev/null | head -n 1)
	min=1	# 0 turns the panel off completely
	;;
kbd)
	subsys=leds
	dir=/sys/class/leds/kbd_backlight
	min=0
	;;
*)
	usage
	;;
esac

pct=${2:-}
case "$pct" in
[+-][0-9]*) ;;
*) usage ;;
esac

if [ -z "$dir" ] || [ ! -r "$dir/brightness" ]; then
	echo "${0##*/}: no $1 backlight found" >&2
	exit 1
fi

cur=$(cat "$dir/brightness")
max=$(cat "$dir/max_brightness")
step=$((max * ${pct#?} / 100))
[ "$step" -ge 1 ] || step=1

case "$pct" in
-*) new=$((cur - step)) ;;
*) new=$((cur + step)) ;;
esac
[ "$new" -ge "$min" ] || new=$min
[ "$new" -le "$max" ] || new=$max

exec dbus-send --system --print-reply=literal \
	--dest=org.freedesktop.login1 /org/freedesktop/login1/session/auto \
	org.freedesktop.login1.Session.SetBrightness \
	string:"$subsys" string:"${dir##*/}" uint32:"$new" >/dev/null
